{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compilar proyecto completo",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-g3",
                "main.cpp",
                "Accion.cpp",
                "ArbolSubtareas.cpp",
                "Autenticacion.cpp",
                "CLI.cpp",
                "ColaPrioridad.cpp",
                "ColaTareas.cpp",
                "GestorArchivosCSV.cpp",
                "GestorSistema.cpp",
                "ListaUsuarios.cpp",
                "NodoTarea.cpp",
                "Ordenador.cpp",
                "PilaHistorial.cpp",
                "Tarea.cpp",
                "Usuario.cpp",
                "ValidacionEntrada.cpp",
                "-o",
                "output/main"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
